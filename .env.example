# Copy to .env and fill in. NEVER commit .env (it is gitignored).
# One variable per source, matching the password_env names in
# config/config.yaml. For Google-account sources these are 16-character
# app passwords (myaccount.google.com/apppasswords — requires 2-Step
# Verification). Sources added through the web UI store their password on
# the data volume instead and need no entry here.

GMAILIFICATION_SRC_ALICE_OLD_COMPANY=
GMAILIFICATION_SRC_ALICE_ISP=
GMAILIFICATION_SRC_BOB_CLUB=

# Admin password for the web interface (basic auth, any username). While this
# is unset, the web UI is read-only and configuration editing is disabled.
GMAILIFICATION_ADMIN_PASSWORD=

# Optional: logging tweaks
# GMAILIFICATION_LOG_JSON=1
# GMAILIFICATION_LOG_LEVEL=DEBUG
